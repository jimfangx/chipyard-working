def repair_route_drcs(x: HammerTool) -> bool:
    x.append(r'''
        puts "##### Final routing DRC repair"

        set max_passes 20

        for {set pass 1} {$pass <= $max_passes} {incr pass} {
            puts "##### DRC repair pass $pass / $max_passes"

            check_drc

            ##########################################################
            # Count MET1 short markers only.
            #
            # Use both subtype and message so this is tolerant of
            # whether Innovus reports the subtype as Short,
            # Metal_Short, MetalShort, etc.
            ##########################################################

            set met1_short_count 0

            foreach m [get_db markers] {
                set layer_name [string tolower [get_db $m .layer.name]]

                if {$layer_name ne "met1"} {
                    continue
                }

                set subtype [string tolower [get_db $m .subtype]]
                set message [string tolower [get_db $m .message]]

                if {
                    [string match "*short*" $subtype] ||
                    [string match "*short*" $message]
                } {
                    incr met1_short_count
                }
            }

            puts "##### MET1 short count after check_drc: $met1_short_count"

            ##########################################################
            # Stop immediately when MET1 is short-clean.
            ##########################################################

            if {$met1_short_count == 0} {
                puts "##### MET1 shorts cleared after $pass pass(es)"
                break
            }

            ##########################################################
            # Otherwise remove regular routing involved in DRCs and
            # let NanoRoute rebuild it.
            ##########################################################

            if {$pass < $max_passes} {
                puts "##### Repairing routing: $met1_short_count MET1 short(s) remain"

                delete_routes -regular_wire_with_drc
                route_design
            } else {
                puts "##### WARNING: reached maximum of $max_passes passes with $met1_short_count MET1 short(s) remaining"
            }
        }

        ##############################################################
        # Final verification
        ##############################################################

        puts "##### Final DRC check"
        check_drc

        set final_met1_short_count 0

        foreach m [get_db markers] {
            set layer_name [string tolower [get_db $m .layer.name]]

            if {$layer_name ne "met1"} {
                continue
            }

            set subtype [string tolower [get_db $m .subtype]]
            set message [string tolower [get_db $m .message]]

            if {
                [string match "*short*" $subtype] ||
                [string match "*short*" $message]
            } {
                incr final_met1_short_count
            }
        }

        puts "##### FINAL MET1 SHORT COUNT: $final_met1_short_count"
    ''')
    return True


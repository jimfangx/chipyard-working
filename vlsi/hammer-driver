def block_sram_escape_corridors_from_pg(x: HammerTool) -> bool:
    x.append(r'''
##############################################################
# Reserve the full SRAM placement halo from low-layer PG.
#
# - PG nets only: signal routing remains allowed.
# - Blocks met1 and met2.
# - Covers the entire placement halo around each SRAM.
# - Excludes the SRAM bbox itself.
# - met3 and above are unaffected.
##############################################################

set block_index 0

foreach inst [get_db insts -if {
    .base_cell.name == *sram22*
}] {
    set inst_name [get_db $inst .name]

    # SRAM bbox.
    set ix1 [get_db $inst .bbox.ll.x]
    set iy1 [get_db $inst .bbox.ll.y]
    set ix2 [get_db $inst .bbox.ur.x]
    set iy2 [get_db $inst .bbox.ur.y]

    # Existing placement halo bbox.
    set hx1 [get_db $inst .place_halo_bbox.ll.x]
    set hy1 [get_db $inst .place_halo_bbox.ll.y]
    set hx2 [get_db $inst .place_halo_bbox.ur.x]
    set hy2 [get_db $inst .place_halo_bbox.ur.y]

    if {$hx1 eq "" || $hy1 eq "" || $hx2 eq "" || $hy2 eq ""} {
        error "SRAM '$inst_name' does not have a placement halo"
    }

    ##############################################################
    # Build the halo as four rectangles.
    #
    # Left/right cover the complete halo height.
    # Bottom/top fill only the width directly below/above the SRAM.
    #
    # This avoids covering the SRAM bbox itself.
    ##############################################################

    set rects [list \
        [list $hx1 $hy1 $ix1 $hy2] \
        [list $ix2 $hy1 $hx2 $hy2] \
        [list $ix1 $hy1 $ix2 $iy1] \
        [list $ix1 $iy2 $ix2 $hy2] \
    ]

    create_route_blockage \
        -name sram_lowmetal_pg_halo_$block_index \
        -pg_nets \
        -layers {met1 met2} \
        -rects $rects

    puts "SRAM low-metal PG blockage:"
    puts "  instance: $inst_name"
    puts "  SRAM bbox: {$ix1 $iy1 $ix2 $iy2}"
    puts "  halo bbox: {$hx1 $hy1 $hx2 $hy2}"
    puts "  layers: {met1 met2}"
    puts "  rectangles: $rects"

    incr block_index
}

puts "block_sram_escape_corridors_from_pg: created $block_index blockage(s)"
##############################################################
''')

    return True

def route_sram_pin_escapes(x: HammerTool) -> bool:
    # m1 doglegs from sram met1 pins
    x.append(r'''
        ##############################################################
        # SRAM22 met1 -> met2 pin escapes
        ##############################################################

        proc snap_to_track {value start step} {
            return [expr {
                $start + round(($value - $start) / $step) * $step
            }]
        }

        set met1_layer [get_db layers met1]
        set met2_layer [get_db layers met2]

        set met1_width [get_db $met1_layer .width]
        set met2_width [get_db $met2_layer .width]

        # Find the DEF track pattern containing met2.
        foreach track [get_db current_design .track_patterns] {
            if {[lsearch -exact [get_db $track .layers.name] met2] >= 0} {
                set met2_track $track
                break
            }
        }

        set met2_track_direction [get_db $met2_track .direction]
        set met2_track_start     [get_db $met2_track .start]
        set met2_track_step      [get_db $met2_track .step]

        # Get the met1-to-met2 generated-via rule and create/lookup a 1x1 via.
        set via12_rule [lindex [get_db via_def_rules -if {
            .bottom_layer.name == met1 &&
            .top_layer.name == met2
        }] 0]

        set via12 [create_via_definition \
            -via_rule $via12_rule \
            -row_column {1 1}]

        # Six staggered via depths fit comfortably inside the 8.28 um halo.
        set num_lanes      6
        set first_depth    [expr {2.0 * $met2_track_step}]
        set lane_pitch     [expr {2.0 * $met2_track_step}]
        set landing_length $met2_track_step

        set escape_count 0

        foreach inst [get_db insts -if {
            .base_cell.name == *sram22*
        }] {
            set inst_bbox [lindex [get_db $inst .bbox] 0]
            lassign $inst_bbox llx lly urx ury

            unset -nocomplain edge_pins
            array set edge_pins {
                left   {}
                right  {}
                bottom {}
                top    {}
            }

            # Collect and sort signal pins on each macro edge.
            foreach pin [get_db $inst .pins] {
                set pin_name [string tolower \
                    [get_db $pin .base_pin.name]]

                if {[regexp {
                    ^(vdd|vss|vpwr|vgnd|vpb|vnb|vccd|vssd|vdda|vssa)
                } $pin_name]} {
                    continue
                }

                set net [get_db $pin .net]
                if {$net eq ""} {
                    continue
                }

                set met1_shapes [get_db \
                    $pin .base_pin.physical_pins.layer_shapes \
                    -if {.layer.name == met1}]

                set local_rect [lindex \
                    [get_db $met1_shapes .shapes.rect] 0]

                set pin_rect [get_transform_shapes -inst $inst -local_pt $local_rect]

                lassign $pin_rect px1 py1 px2 py2

                set px [expr {($px1 + $px2) / 2.0}]
                set py [expr {($py1 + $py2) / 2.0}]

                set edge left
                set nearest [expr {abs($px - $llx)}]

                set distance [expr {abs($px - $urx)}]
                if {$distance < $nearest} {
                    set edge right
                    set nearest $distance
                }

                set distance [expr {abs($py - $lly)}]
                if {$distance < $nearest} {
                    set edge bottom
                    set nearest $distance
                }

                set distance [expr {abs($py - $ury)}]
                if {$distance < $nearest} {
                    set edge top
                }

                if {$edge eq "left" || $edge eq "right"} {
                    set along_edge $py
                } else {
                    set along_edge $px
                }

                lappend edge_pins($edge) [list \
                    $along_edge \
                    [get_db $net .name] \
                    $px \
                    $py]
            }

            foreach edge {left right bottom top} {
                set pin_index 0

                foreach pin_info \
                    [lsort -real -index 0 $edge_pins($edge)] {

                    lassign $pin_info along_edge net_name px py

                    set lane [expr {$pin_index % $num_lanes}]
                    set depth [expr {
                        $first_depth + $lane * $lane_pitch
                    }]

                    # Place the via at a staggered distance normal to
                    # the SRAM edge. This keeps the M1 escape straight
                    # and prevents M1 doglegs from crossing each other.
                    switch -- $edge {
                        left {
                            set vx [expr {$llx - $depth}]
                            set vy $py

                            # DEF TRACKS X means vertical met2 tracks.
                            if {$met2_track_direction eq "x"} {
                                set vx [snap_to_track \
                                    $vx \
                                    $met2_track_start \
                                    $met2_track_step]
                            }
                        }

                        right {
                            set vx [expr {$urx + $depth}]
                            set vy $py

                            if {$met2_track_direction eq "x"} {
                                set vx [snap_to_track \
                                    $vx \
                                    $met2_track_start \
                                    $met2_track_step]
                            }
                        }

                        bottom {
                            set vx $px
                            set vy [expr {$lly - $depth}]

                            # DEF TRACKS Y means horizontal met2 tracks.
                            if {$met2_track_direction eq "y"} {
                                set vy [snap_to_track \
                                    $vy \
                                    $met2_track_start \
                                    $met2_track_step]
                            }
                        }

                        top {
                            set vx $px
                            set vy [expr {$ury + $depth}]

                            if {$met2_track_direction eq "y"} {
                                set vy [snap_to_track \
                                    $vy \
                                    $met2_track_start \
                                    $met2_track_step]
                            }
                        }
                    }

                    # Fixed M1 escape from the SRAM pin to the via site.
                    create_shape \
                        -net $net_name \
                        -layer met1 \
                        -path_segment [list $px $py $vx $vy] \
                        -width $met1_width \
                        -status fixed

                    # Fixed M1-to-M2 via.
                    create_via \
                        -net $net_name \
                        -via_def $via12 \
                        -location [list $vx $vy] \
                        -status fixed

                    set half_landing \
                        [expr {$landing_length / 2.0}]

                    if {$met2_track_direction eq "x"} {
                        # Vertical met2 tracks.
                        set tx [snap_to_track \
                            $vx \
                            $met2_track_start \
                            $met2_track_step]

                        # Short M2 jog when the via is not already on-track.
                        if {[expr {abs($tx - $vx)}] > 1.0e-6} {
                            create_shape \
                                -net $net_name \
                                -layer met2 \
                                -path_segment [list \
                                    $vx $vy $tx $vy] \
                                -width $met2_width \
                                -status fixed
                        }

                        create_shape \
                            -net $net_name \
                            -layer met2 \
                            -path_segment [list \
                                $tx [expr {$vy - $half_landing}] \
                                $tx [expr {$vy + $half_landing}]] \
                            -width $met2_width \
                            -status fixed
                    } else {
                        # Horizontal met2 tracks.
                        set ty [snap_to_track \
                            $vy \
                            $met2_track_start \
                            $met2_track_step]

                        if {[expr {abs($ty - $vy)}] > 1.0e-6} {
                            create_shape \
                                -net $net_name \
                                -layer met2 \
                                -path_segment [list \
                                    $vx $vy $vx $ty] \
                                -width $met2_width \
                                -status fixed
                        }

                        create_shape \
                            -net $net_name \
                            -layer met2 \
                            -path_segment [list \
                                [expr {$vx - $half_landing}] $ty \
                                [expr {$vx + $half_landing}] $ty] \
                            -width $met2_width \
                            -status fixed
                    }

                    incr pin_index
                    incr escape_count
                }
            }
        }

        puts "route_sram_pin_escapes: created $escape_count SRAM pin escapes"

        ##############################################################
    ''')

    return True


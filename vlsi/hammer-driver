    $vddio_m3_x $vddio_m3_y1

por_create_shape \
    VDDIO met4 1.600 \
    $vddio_m4_x0 $vddio_m4_y \
    $vddio_m4_x1 $vddio_m4_y

por_add_local_vias \
    VDDIO met3 met4 \
    [expr {$por_x - 5.500}] \
    [expr {$por_y - 71.500}] \
    [expr {$por_x + 1.500}] \
    [expr {$por_y +  3.000}]


########################################################################
# VSS 3.3 V: por/vss3v3
#
# PoR pin is met4.
#
# The short met4 segment touches the wide macro pin. It drops to met3
# and reaches the VSS met4 bus in the same 20 um IO filler.

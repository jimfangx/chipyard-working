    "place_por: final bbox=%s place_status=%s" \
    [get_db $por_obj .bbox] \
    [get_db $por_obj .place_status]]

########################################################################
# Basic placement assertions
########################################################################

if {[get_db $por_obj .place_status] ne "fixed"} {
    error [format \
        "PoR instance '%s' was not fixed after place_inst" \
        $por_inst]
}
""")

    return True


def route_por_power(x: HammerTool) -> bool:
    x.append(r'''
########################################################################
# Route simple_por PG pins.
#
# Must run after:
#   - the PoR has been placed and fixed
#   - the IO ring/fillers have been created
#   - the VDD/VSS power rings have been created
#
# All coordinates below are relative to the placed PoR origin and
# reproduce the routing in ofo-hv-routing.def.
########################################################################

set por_inst "por"

set por_objs [get_db insts $por_inst]
if {[llength $por_objs] != 1} {
    error [format \
        "Expected exactly one PoR instance named '%s'; found %d" \
        $por_inst [llength $por_objs]]
}

set por_obj [lindex $por_objs 0]

if {[get_db $por_obj .place_status] ne "fixed"} {
    error "PoR instance '$por_inst' must be fixed before power routing"
}

if {[get_db $por_obj .orient] ne "mx"} {
    error [format \
        "PoR instance '%s' must have mx orientation; found '%s'" \
        $por_inst [get_db $por_obj .orient]]
}

lassign [lindex [get_db $por_obj .location] 0] por_x por_y

puts [format \
    "route_por_power: PoR origin={%.3f %.3f}" \
    $por_x $por_y]


########################################################################
# Logical PG attachment
#
# These are safe to retain even when the same associations are expressed
# by CPF, because they make the intended macro-pin mapping explicit.
########################################################################

connect_global_net VDDIO \
    -type pg_pin \
    -pin_base_name vdd3v3 \
    -single_inst $por_inst \
    -override \
    -verbose

connect_global_net VDD \
    -type pg_pin \
    -pin_base_name vdd1v8 \
    -single_inst $por_inst \
    -override \
    -verbose

connect_global_net VSS \
    -type pg_pin \
    -pin_base_name vss3v3 \
    -single_inst $por_inst \
    -override \
    -verbose

connect_global_net VSS \
    -type pg_pin \
    -pin_base_name vss1v8 \
    -single_inst $por_inst \
    -override \
    -verbose


########################################################################
# Create a fixed SPECIALNET wire segment.
########################################################################

proc por_create_shape {net layer width x1 y1 x2 y2} {
    puts [format \
        "route_por_power: %-5s %-4s width=%.3f {%8.3f %8.3f} -> {%8.3f %8.3f}" \
        $net $layer $width $x1 $y1 $x2 $y2]

    return [create_shape \
        -net $net \
        -layer $layer \
        -path_segment [list $x1 $y1 $x2 $y2] \
        -width $width \
        -status FIXED]
}


########################################################################
# Add vias only between local wires belonging to one net.
#
# The area includes:
#   - the newly created PoR route
#   - the existing filler bus or power ring
#
# Selecting a local area avoids adding vias throughout the entire chip.
########################################################################

proc por_add_local_vias {
    net bottom_layer top_layer llx lly urx ury
} {
    set area [list $llx $lly $urx $ury]

    set local_wires [get_obj_in_area \
        -obj_type special_wire \
        -areas $area \
        -layers [list $bottom_layer $top_layer]]

    if {[llength $local_wires] == 0} {
        error [format \
            "No special wires found for %s in area %s on {%s %s}" \
            $net $area $bottom_layer $top_layer]
    }

    set net_wires [get_db $local_wires \
        -if ".net.name == $net"]

    if {[llength $net_wires] < 2} {
        error [format \
            "Expected at least two %s special wires in area %s on {%s %s}; found %d" \
            $net $area $bottom_layer $top_layer \
            [llength $net_wires]]
    }

    deselect_obj -all
    select_obj $net_wires

    update_power_vias \
        -add_vias true \
        -between_selected_wires true \
        -bottom_layer $bottom_layer \
        -top_layer $top_layer \
        -orthogonal_only false

    deselect_obj -all
}


########################################################################
# VDDIO: por/vdd3v3
#
# PoR pin is met4.
#
# The short met4 segment touches the macro pin. It drops to a vertical
# met3 trunk, which reaches the VDDIO met4 bus in the 20 um IO filler.

def _has_cached_sram_placement(x: HammerTool) -> bool:
    """
    Warm-path detector. Returns True if the user has passed in a Hammer
    placement_constraints yaml (via HAMMER_EXTRA_ARGS -p ...) that already
    contains hardmacro entries for SRAM instances.
    """
    consts = x.get_setting("vlsi.inputs.placement_constraints") or []
    for c in consts:
        path = c.get("path", "") if isinstance(c, dict) else getattr(c, "path", "") or ""
        ctype = c.get("type", "") if isinstance(c, dict) else getattr(c, "type", "")
        ctype_str = str(ctype).lower()
        if "hardmacro" in ctype_str:
            return True
    return False

def place_sram_macros(x: HammerTool) -> bool:
    """
    Place SRAM22 macros with Innovus concurrent macro placement.

    After placement, reproduce the relevant SRAM protection generated by
    Hammer's normal hardmacro floorplan script:

      * route halo around each SRAM
      * placement halo around each SRAM
      * PG-only route blockage covering the placement-halo polygon

    We intentionally retain the 8.28 um placement halo used by this flow,
    rather than Hammer's default/generated 2.2 um halo, because the larger
    halo reserves the SRAM pin-escape corridor.

    For the Rocket icache tag SRAM, match Hammer's generated behavior:
      route halo: met1 -> met4
      PG blockage: met1/met2/met3

    All other SRAM22 macros:
      route halo: met1 -> met2
      PG blockage: met1
    """

    # ----------------------------------------------------------------------
    # Common SRAM protection TCL.
    #
    # This is used by both:
    #
    #   cold path:
    #       SRAMs were placed by place_design -concurrent_macros
    #
    #   warm path:
    #       SRAM coordinates came from cached Hammer placement constraints
    #
    # ----------------------------------------------------------------------

    sram_keepout_tcl = r'''
        ##############################################################
        # SRAM physical protection
        ##############################################################

        proc apply_sram_keepouts {sram_inst} {
            set sram_name [get_db $sram_inst .name]

            # ----------------------------------------------------------
            # Match the route-halo behavior emitted by Hammer's normal
            # hardmacro floorplan script.
            #
            # Most SRAM22 macros:
            #
            #   create_route_halo
            #       bottom = met1
            #       top    = met2
            #
            #   PG blockage:
            #       met1
            #
            # Rocket icache tag SRAM:
            #
            #   create_route_halo
            #       bottom = met1
            #       top    = met4
            #
            #   PG blockage:
            #       met1 met2 met3
            #
            # This distinction comes directly from the Hammer-generated
            # floorplan for this design.
            # ----------------------------------------------------------

            set route_halo_top_layer met2
            set pg_blockage_layers {met1}

            puts "place_sram_macros: protecting $sram_name"
            puts "  route halo:       met1 -> $route_halo_top_layer"
            puts "  route halo space: 2.0"
            puts "  place halo:       8.28"
            puts "  PG block layers:  $pg_blockage_layers"

            # ----------------------------------------------------------
            # Routing halo.
            #
            # Match Hammer's generated hardmacro handling.
            # ----------------------------------------------------------

            create_route_halo \
                -bottom_layer met1 \
                -space 2.0 \
                -top_layer $route_halo_top_layer \
                -inst $sram_name

            # ----------------------------------------------------------
            # Placement halo.
            #
            # Keep the larger 8.28 um corridor used by our SRAM pin
            # escape strategy rather than Hammer's default 2.2 um.
            # ----------------------------------------------------------

            create_place_halo \
                -insts $sram_name \
                -halo_deltas {8.28 8.28 8.28 8.28} \
                -snap_to_site

            # ----------------------------------------------------------
            # PG-only routing blockage.
            #
            # Hammer generates this from the placement-halo polygon.
            # This prevents PG routing on the protected lower layers
            # throughout the SRAM + halo region.
            #
            # Signal routing is NOT blocked by this object because
            # -pg_nets restricts the blockage to PG nets.
            # ----------------------------------------------------------

            set pg_blockage_shape \
                [get_db $sram_inst .place_halo_polygon]

            if {$pg_blockage_shape eq ""} {
                error "place_sram_macros: no place_halo_polygon for $sram_name"
            }

            create_route_blockage \
                -pg_nets \
                -layers $pg_blockage_layers \
                -polygon $pg_blockage_shape
        }
    '''

    # ----------------------------------------------------------------------
    # Warm path.
    #
    # SRAM placement was supplied through:
    #
    #     vlsi.inputs.placement_constraints
    #
    # Do not run concurrent macro placement again. Just reproduce the
    # physical protection that the SRAMs need.
    # ----------------------------------------------------------------------

    if _has_cached_sram_placement(x):
        x.append(
            sram_keepout_tcl
            + r'''
            puts "place_sram_macros: warm path -- SRAM placement supplied via vlsi.inputs.placement_constraints, skipping macro placement entirely"

            set sram_insts \
                [get_db insts -if {.base_cell.name == *sram22*}]

            if {[llength $sram_insts] == 0} {
                error "place_sram_macros: no SRAM22 instances found"
            }

            foreach sram_inst $sram_insts {
                apply_sram_keepouts $sram_inst
            }

            # SRAM locations came from the placement-constraint cache.
            # Lock them before normal standard-cell placement proceeds.
            set_db $sram_insts .place_status fixed

            puts "place_sram_macros: warm path protected [llength $sram_insts] SRAMs"
        '''
        )

        return True

    # ----------------------------------------------------------------------
    # Cold/checkpoint path.
    #
    # Solve macro placement, apply the same SRAM physical protection, then
    # export the solved coordinates as Hammer placement_constraints YAML.
    #
    # Later:
    #
    #   make par HAMMER_EXTRA_ARGS="-p <cache_path>"
    #
    # selects the warm path above.
    # ----------------------------------------------------------------------

    cache_path = f"{x.run_dir}/sram_macro_placement.yml"
    top_module = x.top_module
    # | SRAM |<--- 8.28 halo --->|<--- FREE --->|<--- 8.28 halo --->| SRAM |
    #         \_____________________________________________________/
    #                     -min_space_to_macro
    # free_channel = min_space_to_macro - 2 × 8.28
    
    x.append(
        sram_keepout_tcl
        + f'''
        ##############################################################
        # Concurrent SRAM macro placement
        ##############################################################

        set_macro_place_constraint \
            -max_io_pin_group_keep_out 20 \
            -align_parallel_run_length_ratio 0.4 \
            -align_range_ratio 1.0 \
            -min_space_to_core 41.40 \
            -forbidden_space_to_core 20.70 \
            -min_space_to_macro 41.40 \
            -forbidden_space_to_macro 20.70 \
            -parallel_run_length 0.0 \
            -flip_macro_focus narrow_channel

        # create_pg_model_for_macro_place -file golden_pg_model.tcl
        # source golden_pg_model.tcl
        set_macro_place_constraint -pg_resource_model "met3 0.00076274 met4 0.00028909 met5 0.0075615 "

        puts "place_sram_macros: place_design -concurrent_macros"
        place_design -concurrent_macros

        puts "place_sram_macros: place_macro_detail"
        place_macro_detail

        ##############################################################
        # Find and protect SRAMs
        ##############################################################

        set sram_insts \
            [get_db insts -if {{.base_cell.name == *sram22*}}]

        if {{[llength $sram_insts] == 0}} {{
            error "place_sram_macros: no SRAM22 instances found after macro placement"
        }}

        foreach sram_inst $sram_insts {{
            apply_sram_keepouts $sram_inst
        }}

        # Fix only SRAM positions. Standard cells remain under Innovus
        # placement control.
        set_db $sram_insts .place_status fixed

        puts "place_sram_macros: protected and fixed [llength $sram_insts] SRAMs"

        ##############################################################
        # Debug/checkpoint DEF
        ##############################################################

        write_def_by_section \
            -comp_placement \
            -no_nets \
            temp_placement.def

        check_floorplan \
            -out_file post_macro_place_fp_check.rpt

        ##############################################################
        # Export solved SRAM placement as Hammer constraints
        ##############################################################

        set _sram_cache_path "{cache_path}"
        set _sram_top_module "{top_module}"

        if {{[catch {{
            set _fh [open $_sram_cache_path w]

            puts $_fh "# Auto-generated by place_sram_macros hook -- solved SRAM placement."
            puts $_fh "# Pass via HAMMER_EXTRA_ARGS=\\"-p $_sram_cache_path\\" to skip concurrent macro placement on later runs."
            puts $_fh "vlsi.inputs.placement_constraints_meta: append"
            puts $_fh "vlsi.inputs.placement_constraints:"

            foreach _inst $sram_insts {{
                set _name   [get_db $_inst .name]
                set _loc    [get_db $_inst .location]
                set _orient [string tolower [get_db $_inst .orient]]

                set _xy [lindex $_loc 0]
                set _x  [lindex $_xy 0]
                set _y  [lindex $_xy 1]

                puts $_fh "  - path: \\"$_sram_top_module/$_name\\""
                puts $_fh "    type: hardmacro"
                puts $_fh "    x: $_x"
                puts $_fh "    y: $_y"
                puts $_fh "    orientation: $_orient"
            }}

            close $_fh

            puts "place_sram_macros: wrote SRAM placement cache to $_sram_cache_path"

        }} _err]}} {{
            puts "place_sram_macros: WARNING failed to write SRAM placement cache: $_err"
        }}
    '''
    )

    return True


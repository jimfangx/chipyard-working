# TODO(jimfang) this might be too low and run into the vss/vdd power ring
def place_por(ht: HammerTool) -> bool:
    """
    Place the logical simple_por instance at the lower-right corner of the
    core, reproducing the placement and halos from the DEF based routing, but with relative coordinates.

    Existing DEF relationship:
        por_x = core_urx - 56.580 um
        por_y = core_lly -  6.120 um
        orientation = FS in DEF = mx in Stylus Common UI
    """
    
    ht.append(r"""
########################################################################
# Place simple_por at the lower-right corner of the core
########################################################################

# Do not include the top-level module name here.
#
# Examples:
#   Top-level RTL instance:             por
#   Instance inside system hierarchy:  system/por
set por_inst "por"

# Placement relationship recovered from ofo-hv-routing.def.
set por_right_anchor 56.580
set por_below_core    6.120

########################################################################
# Confirm the instance exists
########################################################################

set por_objs [get_db insts $por_inst]

if {[llength $por_objs] != 1} {
    error [format \
        "Expected exactly one PoR instance named '%s'; found %d: %s" \
        $por_inst \
        [llength $por_objs] \
        $por_objs]
}

set por_obj [lindex $por_objs 0]

########################################################################
# Obtain the current core boundary
########################################################################

set core_urx [get_db current_design .core_bbox.ur.x]
set core_lly [get_db current_design .core_bbox.ll.y]

if {$core_urx eq "" || $core_lly eq ""} {
    error "The core bounding box has not been created before place_por"
}

########################################################################
# Calculate placement
########################################################################

set por_x [expr {$core_urx - $por_right_anchor}]
set por_y [expr {$core_lly - $por_below_core}]

puts [format \
    "place_por: core_urx=%.3f core_lly=%.3f" \
    $core_urx \
    $core_lly]

puts [format \
    "place_por: placing %s at {%.3f %.3f}, orient=mx, status=fixed" \
    $por_inst \
    $por_x \
    $por_y]

########################################################################
# Place the macro
#
# DEF orientation FS corresponds to Common UI orientation mx:
# reflection across the X axis.
########################################################################

place_inst \
    $por_inst \
    [list $por_x $por_y] \
    mx \
    -fixed

########################################################################
# Reproduce the asymmetric placement halo from the DEF
#
# halo_deltas order:
#     left bottom right top
#
# Old DEF:
#     HALO 10120 0 0 11350
########################################################################

create_place_halo \
    -insts $por_inst \
    -halo_deltas {10.120 0.000 0.000 11.350}
    

########################################################################
# Reproduce the routing halo from the DEF
#
# This is not the separate Hammer met1 obstruction.
########################################################################

create_route_halo \
    -inst $por_inst \
    -bottom_layer li1 \
    -top_layer met3 \
    -space 2.000

########################################################################
# Report result
########################################################################

set por_obj [lindex [get_db insts $por_inst] 0]


    $collector_x0 \
    [expr {$ls_y + 3.955}] \
    $collector_x1 \
    [expr {$ls_y + 4.185}]

add_fixed_pg_rect VDDIO met1 \
    $collector_x0 \
    [expr {$ls_y + 4.325}] \
    $collector_x1 \
    [expr {$ls_y + 4.695}]

# I/O bus side: met4 down to met2.

    $vddio_x $vddio_bus_y 0.60

# Level-shifter side: met2 down to met1 collector.
add_pg_vias VDDIO met1 met2 \
    $vddio_x [expr {$ls_y + 4.070}] 0.35

# ======================================================================
# VSS
#
# One met2 trunk with four M1->M2 via landings:
#   two near the bottom of the cell
#   two near the top of the cell
# ======================================================================


CHIPTOP_IO_PIN_MAP_PATH = Path(__file__).resolve().parent / "example-sky130-pin-map.yaml"
PERSISTENT_CHIPTOP_IO_NETS = ("VDDIO", "VDD", "VDDA", "VSS") # from nets surfaced in the power plan - see sky130.cpf


def load_chiptop_io_nets(pin_map_path: Path = CHIPTOP_IO_PIN_MAP_PATH) -> List[str]:
    with pin_map_path.open("r") as f:
        pin_map = yaml.safe_load(f)

    if not isinstance(pin_map, dict) or not isinstance(pin_map.get("pins"), dict):
        raise ValueError(f"{pin_map_path} must contain a 'pins' mapping")

    chiptop_io_nets = list(pin_map["pins"].values())
    if not all(isinstance(net, str) for net in chiptop_io_nets):
        raise ValueError(f"All pin-map values in {pin_map_path} must be net names")

    return chiptop_io_nets + [
        net for net in PERSISTENT_CHIPTOP_IO_NETS if net not in chiptop_io_nets
    ]



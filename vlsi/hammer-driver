# Create one fixed rectangular special-net shape.
proc add_fixed_pg_rect {net layer x0 y0 x1 y1} {
    set shape [create_shape \
        -net $net \
        -layer $layer \
        -rect [list $x0 $y0 $x1 $y1] \
        -status fixed]

    return $shape
}

# Add power vias inside a local rectangular area.
proc add_pg_vias {net bottom_layer top_layer x y half_size} {
    set area [list \
        [expr {$x - $half_size}] \
        [expr {$y - $half_size}] \
        [expr {$x + $half_size}] \
        [expr {$y + $half_size}]]

    update_power_vias \
        -add_vias 1 \
        -nets [list $net] \
        -bottom_layer $bottom_layer \
        -top_layer $top_layer \
        -area $area
}

# ======================================================================
# VDDIO
#
# Working DEF:
#   bus-side M4->M2 stack:
#       tap_ll + (6.150, 177.890)
#
#   met2 trunk:
#       x = LS origin - 1.030
